# Environment Configuration

# Database (PostgreSQL)
DATABASE_URL=postgresql://voicerag:voicerag_secret@localhost:5432/voicerag_db

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis (Background Jobs/Cache)
REDIS_URL=redis://localhost:6379/0

# LLM / Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Since user has Llama3 4.7GB, we default to it
OLLAMA_MODEL=llama3

# Embeddings (Local)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranker (Local)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Speech to Text (faster-whisper)
# Using base model to save VRAM
WHISPER_MODEL=base

# Application 
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE=50000000 # 50MB

# API Gateway
API_PORT=8000
API_HOST=0.0.0.0
